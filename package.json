    "jquery.qrcode": "^1.0.3",
    "ladda": "^2.0.3",
    "slick-carousel": "^1.8.1",
    "spin.js": "^4.1.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",

    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-sort-media-queries": "^6.7.1",
    "sass-embedded": "^1.102.0"
  }

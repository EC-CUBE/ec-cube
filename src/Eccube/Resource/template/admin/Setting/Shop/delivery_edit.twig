{% extends '@admin/default_frame.twig' %}

{% set menus = ['setting', 'shop', 'shop_delivery'] %}

{% block title %}{{ 'admin.setting.shop.delivery_setting'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.setting.shop'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}


{% block javascript %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var setFeeAll = document.getElementById('set_fee_all');
            if (setFeeAll) {
                setFeeAll.addEventListener('click', function() {
                    var feeInput = document.getElementById('{{ form.free_all.vars.id }}');
                    var fee = feeInput ? feeInput.value : '';
                    if (fee !== '' && !isNaN(fee) && isFinite(fee)) {
                        document.querySelectorAll('input[name$="[fee]"]').forEach(function(el) {
                            el.value = fee;
                        });
                        return;
                    }
                    alert("{{ 'admin.setting.shop.delivery.fee.invalid'|trans }}");
                });
            }
        });
    </script>
    <script>
        function getDeliveryTimeItems() {
            return Array.prototype.slice.call(document.querySelectorAll('.sortable-container .sortable-item'));
        }

        // 並び替え後にsort noを更新
        function updateSortNo() {
            var items = getDeliveryTimeItems();
            items.forEach(function(el, i) {
                var sortNo = el.querySelector('.sort-no');
                if (sortNo) sortNo.value = i + 1;
            });
        }

        // 最初と最後の↑↓を再描画
        function redrawDisableAllows() {
            var items = getDeliveryTimeItems();
            items.forEach(function(item) {
                item.querySelectorAll('a').forEach(function(a) {
                    a.classList.remove('disabled');
                });
            });
            if (items.length > 0) {
                var firstUp = items[0].querySelector('a.action-up');
                if (firstUp) firstUp.classList.add('disabled');
                var lastDown = items[items.length - 1].querySelector('a.action-down');
                if (lastDown) lastDown.classList.add('disabled');
            }
        }

        // 表示順の更新を行う
        function moveSortNo() {
            updateSortNo();
            redrawDisableAllows();
        }

        document.addEventListener('DOMContentLoaded', function() {
            // 降順にソートする
            var itemsWrapper = document.querySelector('.sortable-container');
            if (itemsWrapper) {
                var items = Array.prototype.slice.call(itemsWrapper.querySelectorAll('.sortable-item'));
                items.sort(function(a, b) {
                    var av = parseInt(a.querySelector('.sort-no') ? a.querySelector('.sort-no').value : '0');
                    var bv = parseInt(b.querySelector('.sort-no') ? b.querySelector('.sort-no').value : '0');
                    return av - bv;
                });
                items.forEach(function(el) {
                    itemsWrapper.appendChild(el);
                });
            }

            var collectionHolder = document.getElementById('delivery-time-group');
            if (!collectionHolder) return;
            var index = collectionHolder.querySelectorAll('.delivery-time-item').length;

            redrawDisableAllows();

            // お届け時間設定の新規作成ボタンでお届け時間項目を追加する
            var addBtn = document.getElementById('add-delivery-time-button');
            if (addBtn) {
                addBtn.addEventListener('click', function() {
                    var addInput = document.getElementById('add-delivery-time-value');
                    var deliveryTimeName = addInput ? addInput.value : '';
                    if (deliveryTimeName == '') {
                        return;
                    }

                    var prototype = collectionHolder.dataset.prototype || '';
                    var html = prototype.replace(/__name__/g, index);
                    var template = document.createElement('template');
                    template.innerHTML = html.trim();
                    var newForm = template.content.firstElementChild;
                    if (!newForm) return;

                    var label = newForm.querySelector('.display-label');
                    if (label) label.textContent = deliveryTimeName;

                    // 要素を追加（最終要素の後ろへ）
                    var children = collectionHolder.children;
                    var lastRow = children.length > 0 ? children[children.length - 1] : null;
                    if (lastRow && lastRow.parentNode) {
                        lastRow.parentNode.insertBefore(newForm, lastRow.nextSibling);
                    } else {
                        collectionHolder.appendChild(newForm);
                    }

                    // お届け時間名を入れる
                    var inputId = 'delivery_delivery_times_' + index + '_delivery_time';
                    var input = document.getElementById(inputId);
                    if (input) {
                        input.value = deliveryTimeName;
                        input.setAttribute('data-origin-value', deliveryTimeName);
                    }

                    if (addInput) addInput.value = '';
                    index++;

                    moveSortNo();
                });
            }

            collectionHolder.addEventListener('click', function(e) {
                var current = e.target.closest('li');
                if (!current) return;

                // 明細行の削除
                var remove = e.target.closest('.remove-delivery-time-item');
                if (remove) {
                    e.preventDefault();
                    var tip = bootstrap.Tooltip.getInstance(remove);
                    if (tip) tip.hide();
                    current.remove();
                    moveSortNo();
                    return;
                }

                // Up
                var up = e.target.closest('a.action-up');
                if (up) {
                    e.preventDefault();
                    var prev = current.previousElementSibling;
                    if (prev && prev.classList.contains('sortable-item')) {
                        prev.parentNode.insertBefore(current, prev);
                        moveSortNo();
                    }
                    return;
                }

                // Down
                var down = e.target.closest('a.action-down');
                if (down) {
                    e.preventDefault();
                    var next = current.nextElementSibling;
                    if (next && next.classList.contains('sortable-item')) {
                        next.parentNode.insertBefore(current, next.nextSibling);
                        moveSortNo();
                    }
                    return;
                }

                // 編集
                var edit = e.target.closest('a.action-edit');
                if (edit) {
                    e.preventDefault();
                    current.querySelectorAll('.mode-view').forEach(function(el) { el.classList.add('d-none'); });
                    current.querySelectorAll('.mode-edit').forEach(function(el) { el.classList.remove('d-none'); });
                    current.querySelectorAll('.action-edit-submit, .action-edit-cancel').forEach(function(el) { el.disabled = false; });
                    return;
                }

                // 編集決定
                var submit = e.target.closest('button.action-edit-submit');
                if (submit) {
                    e.preventDefault();
                    var input1 = current.querySelector('.form-control');
                    var value1 = input1 ? input1.value : '';
                    var label1 = current.querySelector('.display-label');
                    if (label1) label1.textContent = value1;
                    current.querySelectorAll('.mode-view').forEach(function(el) { el.classList.remove('d-none'); });
                    current.querySelectorAll('.mode-edit').forEach(function(el) { el.classList.add('d-none'); });
                    current.querySelectorAll('[data-origin-value]').forEach(function(el) {
                        el.setAttribute('data-origin-value', value1);
                    });
                    return;
                }

                // 編集キャンセル
                var cancel = e.target.closest('button.action-edit-cancel');
                if (cancel) {
                    e.preventDefault();
                    current.querySelectorAll('[data-origin-value]').forEach(function(el) {
                        el.value = el.getAttribute('data-origin-value') || '';
                    });
                    var input2 = current.querySelector('.form-control');
                    var value2 = input2 ? input2.value : '';
                    var label2 = current.querySelector('.display-label');
                    if (label2) label2.textContent = value2;
                    current.querySelectorAll('.mode-view').forEach(function(el) { el.classList.remove('d-none'); });
                    current.querySelectorAll('.mode-edit').forEach(function(el) { el.classList.add('d-none'); });
                    return;
                }

                // 表示・非表示の切り替え
                var visible = e.target.closest('a.action-visible');
                if (visible) {
                    e.preventDefault();
                    var icon = visible.querySelector('i');
                    var visibleInput = current.querySelector('.visible');
                    if (icon && icon.classList.contains('fa-toggle-on')) {
                        icon.classList.add('fa-toggle-off');
                        icon.classList.remove('fa-toggle-on');
                        visible.setAttribute('title', '{{ 'admin.common.to_show'|trans }}');
                        visible.setAttribute('data-bs-original-title', '{{ 'admin.common.to_show'|trans }}');
                        if (visibleInput) visibleInput.value = '0';
                    } else if (icon) {
                        icon.classList.add('fa-toggle-on');
                        icon.classList.remove('fa-toggle-off');
                        visible.setAttribute('title', '{{ 'admin.common.to_hide'|trans }}');
                        visible.setAttribute('data-bs-original-title', '{{ 'admin.common.to_hide'|trans }}');
                        if (visibleInput) visibleInput.value = '1';
                    }
                    var tooltip = bootstrap.Tooltip.getInstance(visible);
                    if (tooltip) tooltip.show();
                    return;
                }
            });

            // Drag and Drop
            var sortContainer = document.querySelector('.sortable-container');
            if (sortContainer && typeof Sortable !== 'undefined') {
                Sortable.create(sortContainer, {
                    draggable: '.sortable-item',
                    filter: 'input, textarea, select, button, a',
                    preventOnFilter: false,
                    animation: 150,
                    onUpdate: function() {
                        moveSortNo();
                    }
                });
            }

            // 編集時, エラーがあれば入力欄を表示.
            collectionHolder.querySelectorAll('.is-invalid').forEach(function(el) {
                var current = el.closest('li');
                if (!current) return;
                current.querySelectorAll('.mode-view').forEach(function(e) { e.classList.add('d-none'); });
                current.querySelectorAll('.mode-edit').forEach(function(e) { e.classList.remove('d-none'); });
            });
        });
    </script>
{% endblock javascript %}

{% block main %}
    <form method="post" action="{{ delivery_id ? url('admin_setting_shop_delivery_edit', {'id': delivery_id}) : url('admin_setting_shop_delivery_new') }}">
        {{ form_widget(form._token) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'admin.setting.shop.delivery.base_info'|trans }}</span></div>
                        <div id="ex-delivery-basic" class="card-body">
                            <div class="row">
                                <div class="col-3"><span>{{ 'admin.setting.shop.delivery.delivery_name'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
                                <div class="col mb-2">
                                    {{ form_widget(form.name) }}
                                    {{ form_errors(form.name) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3"><span>{{ 'admin.setting.shop.delivery.delivery_sevice_name'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
                                <div class="col mb-2">
                                    {{ form_widget(form.service_name) }}
                                    {{ form_errors(form.service_name) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="{{ 'tooltip.setting.shop.delivery.tracking_number_url'|trans }}">
                                        <span>{{ 'admin.setting.shop.delivery.tracking_number_url'|trans }}</span><i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.confirm_url) }}
                                    {{ form_errors(form.confirm_url) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-3">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="{{ 'tooltip.setting.shop.delivery.sale_type'|trans }}">
                                        <span>{{ 'admin.setting.shop.delivery.sale_type'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span>
                                        <i class="fa fa-question-circle fa-lg ms-1"></i>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    {{ form_widget(form.sale_type) }}
                                    {{ form_errors(form.sale_type) }}
                                </div>
                            </div>
                            {# エンティティ拡張の自動出力 #}
                            {% for f in form|filter(f => f.vars.eccube_form_options.auto_render) %}
                                {% if f.vars.eccube_form_options.form_theme %}
                                    {% form_theme f f.vars.eccube_form_options.form_theme %}
                                    {{ form_row(f) }}
                                {% else %}
                                    <div class="row">
                                        <div class="col-3"><span>{{ f.vars.label|trans }}</span></div>
                                        <div class="col mb-2">
                                            {{ form_widget(f) }}
                                            {{ form_errors(f) }}
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'admin.setting.shop.delivery.payment_method'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
                        <div id="ex-delivery-payment" class="card-body">
                            <div>
                                {{ form_widget(form.payments, {'label_attr': {'class': 'checkbox-inline'}}) }}
                                {{ form_errors(form.payments) }}
                            </div>
                        </div>
                    </div>
                    <div class="card rounded border-0 mb-2">
                        <div class="card-header"><span>{{ 'admin.setting.shop.delivery.delivery_time_setting'|trans }}</span></div>
                        <div id="ex-delivery-time" class="card-body p-0">
                            <div class="card rounded border-0 mb-2">
                                <ul id="delivery-time-group" class="list-group list-group-flush sortable-container"
                                    data-prototype="{% apply escape %}{{ include('@admin/Setting/Shop/delivery_time_prototype.twig', {'form': form.delivery_times.vars.prototype}) }}{% endapply %}">
                                    <li class="list-group-item">
                                        <div class="row">
                                            <div class="col-auto d-flex align-items-center">
                                                <input id="add-delivery-time-value" class="form-control" type="text">
                                            </div>
                                            <div class="col-auto d-flex align-items-center">
                                                <button id="add-delivery-time-button" class="btn btn-ec-regular" type="button">{{ 'admin.common.create__new'|trans }}</button>
                                            </div>
                                        </div>
                                    </li>
                                    {% for child in form.delivery_times %}
                                        {{ include('@admin/Setting/Shop/delivery_time_prototype.twig', {'form': child}) }}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="mb-4">{{ 'admin.common.drag_and_drop_description'|trans }}</p>
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header"><span>{{ 'admin.setting.shop.delivery.delivery_fee_by_pref'|trans }}</span><span class="badge bg-primary ms-1">{{ 'admin.common.required'|trans }}</span></div>
                        <div id="ex-delivery-fee" class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">
                                    <div class="row justify-content-start">
                                        <div class="col-2">
                                            <div class="d-inline-block align-middle" data-bs-toggle="tooltip"
                                                 data-bs-placement="top" title="{{ 'tooltip.setting.shop.delivery.apply_to_pref'|trans }}"><span
                                                        class="card-title">{{ 'admin.setting.shop.delivery.apply_to_pref__title'|trans }}</span><i
                                                        class="fa fa-question-circle fa-lg ms-1"></i></div>
                                        </div>
                                        <div class="col-3">
                                            {{ form_widget(form.free_all) }}
                                            {{ form_errors(form.free_all) }}
                                        </div>
                                        <div class="col-auto">
                                            <button id="set_fee_all" class="btn btn-ec-regular" type="button">{{ 'admin.setting.shop.delivery.apply_to_pref__button'|trans }}</button>
                                        </div>
                                    </div>
                                </li>
                                <li class="list-group-item">
                                    {% for child in form.delivery_fees %}
                                        {% if loop.index % 2 != 0 %}<div class="row mb-2">{% endif %}
                                        <div class="col{{ loop.last ? '-6' }}">
                                            <div class="row">
                                                <div class="col-2">
                                                    <label>{{ child.vars.data.pref }}</label>
                                                </div>
                                                <div class="col ps-0">
                                                    {{ form_widget(child.fee) }}
                                                    {{ form_errors(child.fee) }}
                                                </div>
                                            </div>
                                        </div>
                                        {% if loop.index % 2 == 0 or loop.last %}</div>{% endif %}
                                    {% endfor %}
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card rounded border-0 mb-4">
                        <div id="ex-delivery-shop" class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="{{ 'tooltip.setting.shop.delivery.shop_memo'|trans }}">
                                    <span class="card-title">{{ 'admin.common.shop_memo'|trans }}<i
                                                class="fa fa-question-circle fa-lg ms-1"></i></span></div>
                                </div>
                                <div class="col-4 text-end"><a data-bs-toggle="collapse" href="#freeArea"
                                                                 aria-expanded="false" aria-controls="freeArea"><i
                                                class="fa fa-angle-up fa-lg"></i></a></div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="freeArea">
                            <div class="card-body">
                                <div>
                                    {{ form_widget(form.description, {'attr': {'rows': 8}}) }}
                                    {{ form_errors(form.description) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="c-conversionArea">
            <div class="c-conversionArea__container">
                <div class="row justify-content-between align-items-center">
                    <div class="col-6">
                        <div class="c-conversionArea__leftBlockItem">
                            <a class="c-baseLink" href="{{ url('admin_setting_shop_delivery') }}">
                                <i class="fa fa-backward" aria-hidden="true"></i><span>{{ 'admin.setting.shop.delivery_list'|trans }}</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div id="ex-conversion-action" class="row align-items-center justify-content-end">
                            <div class="col-auto">
                                {{ form_widget(form.visible) }}
                                {{ form_errors(form.visible) }}
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-ec-conversion px-5" type="submit">{{ 'admin.common.registration'|trans }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}

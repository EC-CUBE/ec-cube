{% extends '@admin/default_frame.twig' %}

{% set menus = ['setting', 'shop', 'shop_delivery'] %}

{% block title %}{{ 'admin.setting.shop.delivery_list'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.setting.shop'|trans }}{% endblock %}

{% block javascript %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            function getItems() {
                return Array.prototype.slice.call(document.querySelectorAll('.sortable-item'));
            }

            var oldSortNos = [];
            getItems().forEach(function(el) {
                oldSortNos.push(el.dataset.sortNo);
            });
            oldSortNos.sort(function(a, b) {
                return a - b;
            }).reverse();

            function updateSortNo() {
                var items = getItems();
                var body = new URLSearchParams();
                items.forEach(function(el, i) {
                    body.append(el.dataset.id, oldSortNos[i]);
                });
                window.eccubeFetch('{{ url('admin_setting_shop_delivery_sort_no_move') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body: body
                }).finally(function() {
                    document.querySelectorAll('.modal-backdrop').forEach(function(el) {
                        el.remove();
                    });
                });
            }

            function redrawDisableAllows() {
                var items = getItems();
                items.forEach(function(item) {
                    item.querySelectorAll('a').forEach(function(a) {
                        a.classList.remove('disabled');
                    });
                });
                if (items.length > 0) {
                    var firstUp = items[0].querySelector('a.action-up');
                    if (firstUp) firstUp.classList.add('disabled');
                    var lastDown = items[items.length - 1].querySelector('a.action-down');
                    if (lastDown) lastDown.classList.add('disabled');
                }
            }

            function moveSortNo() {
                document.body.insertAdjacentHTML('beforeend', '<div class="modal-backdrop show"></div>');
                updateSortNo();
                redrawDisableAllows();
            }

            var container = document.querySelector('.sortable-container');
            if (container && typeof Sortable !== 'undefined') {
                Sortable.create(container, {
                    draggable: '.sortable-item',
                    filter: 'input, textarea, select, button, a',
                    preventOnFilter: false,
                    animation: 150,
                    onUpdate: function() {
                        moveSortNo();
                    }
                });
            }

            if (container) {
                container.addEventListener('click', function(e) {
                    var current = e.target.closest('li');
                    if (!current || !current.classList.contains('sortable-item')) return;

                    var up = e.target.closest('a.action-up');
                    if (up && current.contains(up)) {
                        e.preventDefault();
                        var prev = current.previousElementSibling;
                        if (prev && prev.classList.contains('sortable-item')) {
                            prev.parentNode.insertBefore(current, prev);
                            moveSortNo();
                        }
                        return;
                    }

                    var down = e.target.closest('a.action-down');
                    if (down && current.contains(down)) {
                        e.preventDefault();
                        var next = current.nextElementSibling;
                        if (next && next.classList.contains('sortable-item')) {
                            next.parentNode.insertBefore(current, next.nextSibling);
                            moveSortNo();
                        }
                        return;
                    }
                });
            }

            var deleteModal = document.getElementById('DeleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('shown.bs.modal', function(event) {
                    var target = event.relatedTarget;
                    if (!target) return;
                    var link = deleteModal.querySelector('[data-method="delete"]');
                    if (link) link.setAttribute('href', target.dataset.url || '');
                    var msg = deleteModal.querySelector('p.modal-message');
                    if (msg) msg.textContent = target.dataset.message || '';
                });
            }
        });
    </script>
{% endblock %}

{% block main %}
    <form name="form1" method="post">
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="d-block mb-3">
                        <a class="btn btn-ec-regular" href="{{ url('admin_setting_shop_delivery_new') }}">{{ 'admin.common.create__new'|trans }}</a>
                    </div>
                    <div class="card rounded border-0 mb-4">
                        <div class="card-body p-0">
                            <div class="card rounded border-0">
                                <ul class="list-group list-group-flush sortable-container">
                                    <li class="list-group-item">
                                        <div class="row">
                                            <div class="col-auto"><strong>&nbsp;</strong></div>
                                            <div class="col-auto"><strong>{{ 'admin.common.id'|trans }}</strong></div>
                                            <div class="col-2"><strong>{{ 'admin.setting.shop.delivery.delivery_name'|trans }}</strong></div>
                                        </div>
                                    </li>
                                    {% if Deliveries|length > 0 %}
                                        {% for Delivery in Deliveries %}
                                            <li id="ex-delivery-{{ Delivery.id }}" class="list-group-item sortable-item" data-id="{{ Delivery.id }}" data-sort-no="{{ Delivery.sortNo }}">
                                                <div class="row justify-content-around">
                                                    <div class="col-auto d-flex align-items-center"><i class="fa fa-bars text-ec-gray"></i></div>
                                                    <div class="col-auto d-flex align-items-center">{{ Delivery.id }}</div>
                                                    <div class="col d-flex align-items-center">
                                                        <a href="{{ url('admin_setting_shop_delivery_edit', {id: Delivery.id} ) }}">
                                                            {{ Delivery.name }} / {{ Delivery.service_name }}
                                                        </a>
                                                    </div>
                                                    <div class="col-auto text-end">
                                                        <a href="#" class="btn btn-ec-actionIcon me-2 action-up {% if loop.first %}disabled{% endif %}" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'admin.common.up'|trans }}">
                                                            <i class="fa fa-arrow-up fa-lg text-secondary"></i>
                                                        </a>
                                                        <a href="#" class="btn btn-ec-actionIcon me-2 action-down {% if loop.last %}disabled{% endif %}" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'admin.common.down'|trans }}">
                                                            <i class="fa fa-arrow-down fa-lg text-secondary"></i>
                                                        </a>
                                                        <a class="btn btn-ec-actionIcon me-2 action-visible" href="{{ url('admin_setting_shop_delivery_visibility', {'id': Delivery.id }) }}"
                                                           data-bs-toggle="tooltip" data-bs-placement="top" title="{{ Delivery.visible ? 'admin.common.to_hide'|trans : 'admin.common.to_show'|trans }}"
                                                           data-confirm="false" data-method="put" {{ csrf_token_for_anchor() }} >
                                                            <i class="fa fa-toggle-{{ Delivery.visible ? 'on' : 'off' }} fa-lg text-secondary" aria-hidden="true"></i>
                                                        </a>
                                                        <div class="d-inline-block me-2" data-bs-toggle="tooltip" data-bs-placement="top"
                                                             title="{{ 'admin.common.delete'|trans }}">
                                                            <a class="btn btn-ec-actionIcon" data-bs-toggle="modal" data-bs-target="#DeleteModal"
                                                               data-url="{{ url('admin_setting_shop_delivery_delete', {id: Delivery.Id} ) }}"
                                                               data-message="{{ 'admin.common.delete_modal__message'|trans({ "%name%" : Delivery.name }) }}">
                                                                <i class="fa fa-close fa-lg"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                </ul>
                                <!-- 削除モーダル -->
                                <div class="modal fade" id="DeleteModal" tabindex="-1" role="dialog"
                                     aria-labelledby="DeleteModal" aria-hidden="true">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold">
                                                    {{ 'admin.common.delete_modal__title'|trans }}
                                                </h5>
                                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">

                                                </button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <p class="text-start modal-message"><!-- jsでメッセージを挿入 --></p>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-ec-sub" type="button" data-bs-dismiss="modal">
                                                    {{ 'admin.common.cancel'|trans }}
                                                </button>
                                                <a class="btn btn-ec-delete" href="#" {{ csrf_token_for_anchor() }}
                                                   data-method="delete" data-confirm="false">
                                                    {{ 'admin.common.delete'|trans }}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p>{{ 'admin.common.drag_and_drop_description'|trans }}</p>
                </div>
            </div>
        </div>
    </form>

{% endblock %}

`@admin/Content/faq_collection.twig` の行追加・削除・並び替えを担う JS。
呼び出し側（商品編集・カテゴリFAQ編集）の block javascript で include する。
#}
<script>
    $(function () {
        $('.faq-collection').each(function () {
            var $collection = $(this);
            var $items = $collection.find('.faq-collection__items');

            // 並び順に応じて hidden の表示順に連番を振る
            var updateSortNo = function () {
                $items.find('.sortable-item').each(function (i) {
                    $(this).find('.sort-no').val(i + 1);
                });
            };

            // 先頭と末尾の↑↓を再描画
            var redrawDisableAllows = function () {
                var $sortableItems = $items.find('.sortable-item');
                $sortableItems.find('a.action-up, a.action-down').removeClass('disabled');
                $sortableItems.first().find('a.action-up').addClass('disabled');
                $sortableItems.last().find('a.action-down').addClass('disabled');
            };

            var moveSortNo = function () {
                updateSortNo();
                redrawDisableAllows();
            };

            // 初期表示は表示順の昇順に並べ替える
            var $sorted = $items.find('.sortable-item').sort(function (a, b) {
                return parseInt($(a).find('.sort-no').val(), 10) - parseInt($(b).find('.sort-no').val(), 10);
            });
            $sorted.each(function () {
                $items.append($(this));
            });
            moveSortNo();

            $collection.find('.faq-collection__add').on('click', function () {
                var index = parseInt($collection.attr('data-index'), 10);
                var prototype = $collection.attr('data-prototype');
                var newForm = prototype.replace(/__name__/g, index);
                $collection.attr('data-index', index + 1);
                $items.append(newForm);
                moveSortNo();
            });

            $collection.on('click', '.faq-collection__remove', function () {
                $(this).tooltip('hide');
                $(this).closest('.faq-collection__item').remove();
                moveSortNo();
            });

            // Drag and Drop
            $items.sortable({
                items: '> .sortable-item',
                cursor: 'move',
                update: function () {
                    moveSortNo();
                }
            });

            // Up
            $collection.on('click', 'a.action-up', function (e) {
                e.preventDefault();
                var $current = $(this).closest('.sortable-item');
                if ($current.prev().hasClass('sortable-item')) {
                    $current.prev().before($current);
                    moveSortNo();
                }
            });

            // Down
            $collection.on('click', 'a.action-down', function (e) {
                e.preventDefault();
                var $current = $(this).closest('.sortable-item');
                if ($current.next().hasClass('sortable-item')) {
                    $current.next().after($current);
                    moveSortNo();
                }
            });
        });
    });
</script>

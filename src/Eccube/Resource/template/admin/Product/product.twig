{% extends '@admin/default_frame.twig' %}

{% set menus = ['product', 'product_edit'] %}

{% block title %}{{ 'admin.product.product_registration'|trans }}{% endblock %}
{% block sub_title %}{{ 'admin.product.product_management'|trans }}{% endblock %}

{% form_theme form '@admin/Form/bootstrap_4_horizontal_layout.html.twig' %}

{% block javascript %}
    <script>
        document.addEventListener('drop', function(e) { e.preventDefault(); });
        document.addEventListener('dragover', function(e) { e.preventDefault(); });

        document.addEventListener('DOMContentLoaded', function() {
            {% if has_class == false %}
            (function() {
                var stockUnlimited = document.getElementById('{{ form.class.stock_unlimited.vars.id }}');
                var stock = document.getElementById('{{ form.class.stock.vars.id }}');
                if (stockUnlimited && stock) {
                    var sync = function() {
                        if (stockUnlimited.checked) {
                            stock.setAttribute('disabled', 'disabled');
                            stock.value = '';
                        } else {
                            stock.removeAttribute('disabled');
                        }
                    };
                    sync();
                    stockUnlimited.addEventListener('click', sync);
                    stockUnlimited.addEventListener('change', sync);
                }
            })();
            {% endif %}

            var csrfMeta = document.querySelector('meta[name="eccube-csrf-token"]');
            var csrfToken = csrfMeta ? csrfMeta.getAttribute('content') : '';

            // ファイルアップロード
            // see https://pqina.nl/filepond/
            var inputFileElement = document.querySelector('input[type=file]');
            {% if eccube_config.locale == 'ja' or eccube_config.locale == 'en' %}
            FilePond.setOptions(FilePondLocale_{{ eccube_config.locale }});
            {% endif %}
            FilePond.setOptions({
                server: {
                    process: {
                        url: '{{ path('admin_product_image_process') }}',
                        headers: {
                            'ECCUBE-CSRF-TOKEN': csrfToken,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    },
                    load: {
                        url: '{{ path('admin_product_image_load') }}?source=',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    },
                    revert: {
                        url: '{{ path('admin_product_image_revert') }}',
                        headers: {
                            'ECCUBE-CSRF-TOKEN': csrfToken,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    }
                }
            });
            var pond = FilePond.create(inputFileElement, {
                allowFileTypeValidation: true,
                acceptedFileTypes: [
                    'image/gif',
                    'image/png',
                    'image/jpeg',
                    'image/webp',
                ],
                allowFileSizeValidation: true,
                maxFileSize: 10000000,
                maxFiles: 10,
                allowBrowse: true,
                allowDrop: true,
                allowReorder: true,
                labelIdle: '<i class="fa fa-cloud-upload fa-3x text-ec-lightGray mx-3 align-middle" aria-hidden="true" style="font-size: 40px"></i>{{ 'admin.common.drag_and_drop_image_description'|trans }}<span class="filepond--label-action">{{ 'admin.common.file_select'|trans }}</span>',
                styleItemPanelAspectRatio: 0.5625,
                // 保存されている画像のロード
                files: [
                    {% for image in form.images %}
                    {
                        source: '{{ image.vars.value }}',
                        options: {
                            type: 'local'
                        }
                    },
                    {% endfor %}
                    // 追加してすぐの画像のロード. バリデーションエラーの場合など.
                    {% for add_image in form.add_images %}
                    {
                        source: '{{ add_image.vars.value }}',
                        options: {
                            type: 'local'
                        }
                    },
                    {% endfor %}
                ]
            });

            var uploadZone = document.getElementById('upload-zone');

            var appendHidden = function(html, value, className) {
                if (!uploadZone) return null;
                var tmp = document.createElement('div');
                tmp.innerHTML = html.trim();
                var el = tmp.firstChild;
                if (!el) return null;
                if (value !== undefined && value !== null) el.value = value;
                if (className) el.classList.add(className);
                uploadZone.appendChild(el);
                return el;
            };

            // 画像が追加されたら add_images にファイル名を追加する
            var proto_add = '{{ form_widget(form.add_images.vars.prototype) }}';
            pond.on('processfile', function(error, file) {
                if (error) {
                    console.log(error);
                } else {
                    appendHidden(proto_add.replace(/__name__/g, file.id), file.serverId, 'add_images');
                }
            });
            // 画像が削除されたら delete_images にファイル名を追加する
            var proto_del = '{{ form_widget(form.delete_images.vars.prototype) }}';
            pond.on('removefile', function(error, file) {
                if (error) {
                    console.log(error);
                } else {
                    // file.serverId にはアップロードしたファイル名が格納される.
                    if (file.serverId) {
                        appendHidden(proto_del.replace(/__name__/g, file.id), file.serverId, 'del_images');
                    }
                    if (uploadZone) {
                        // 追加してすぐ削除した画像があれば削除する
                        var added = uploadZone.querySelector('#admin_product_add_images_' + file.id);
                        if (added) added.remove();
                        // 追加後, バリデーションエラーが発生した後に削除した画像
                        uploadZone.querySelectorAll('.add_images[value="' + file.filename + '"]').forEach(function(el) { el.remove(); });
                    }
                }
            });
            pond.on('initfile', function() {
                var el = document.getElementById('product_image_error');
                if (el) el.style.display = 'none';
            });
            pond.on('error', function(error, file) {
                var message = '{{ 'admin.common.upload_error'|trans }}';
                if (error.main !== undefined) {
                    message = `${error.main}: ${error.sub}`;
                }
                var errEl = document.getElementById('product_image_error');
                if (errEl) {
                    // Bootstrap 5 の .invalid-feedback は CSS で display: none のため
                    // 空文字 ('') では display: none が残る. 明示的に block を指定する.
                    errEl.style.display = 'block';
                    var msg = errEl.querySelector('.form-error-message');
                    if (msg) msg.textContent = message;
                }

                // エラーメッセージが表示されてからプレビューエリアのエラーメッセージを非表示にする
                setTimeout(function() {
                    document.querySelectorAll('.filepond--file-status').forEach(function(el) { el.style.display = 'none'; });
                }, 300);
            });

            // バリデーションエラーが出た場合に画像を保持するための hidden を追加しておく
            var proto_image = '{{ form_widget(form.images.vars.prototype) }}';
            {% for image in form.images %}
                appendHidden(proto_image.replace(/__name__/g, '{{ loop.index0 }}'), '{{ image.vars.value }}', 'images');
            {% endfor %}
            {% for add_image in form.add_images %}
                appendHidden('{{ form_widget(add_image) }}', '{{ add_image.vars.value }}', 'add_images');
            {% endfor %}
            {% for delete_image in form.delete_images %}
                appendHidden('{{ form_widget(delete_image) }}', null, 'del_images');
            {% endfor %}

            // タグ管理
            var mainTags = document.getElementById('allTags');
            var adminProductTag = document.getElementById('admin_product_Tag');
            if (adminProductTag) {
                adminProductTag.querySelectorAll('input').forEach(function(input) {
                    if (input.checked) {
                        var btn = document.querySelector('button[data-tag-id="' + input.value + '"]');
                        if (btn) {
                            btn.classList.remove('btn-outline-secondary');
                            btn.classList.add('btn-outline-primary');
                        }
                    }
                });
            }
            if (mainTags) {
                mainTags.addEventListener('click', function(e) {
                    var btnTag = e.target.closest('button.btn');
                    if (!btnTag || !mainTags.contains(btnTag)) return;
                    var tagId = btnTag.dataset.tagId;
                    var input = mainTags.querySelector('input[value="' + tagId + '"]');
                    if (btnTag.classList.contains('btn-outline-primary')) {
                        btnTag.classList.remove('btn-outline-primary');
                        btnTag.classList.add('btn-outline-secondary');
                        if (input) input.checked = false;
                    } else {
                        btnTag.classList.remove('btn-outline-secondary');
                        btnTag.classList.add('btn-outline-primary');
                        if (input) input.checked = true;
                    }
                });
            }

            var confirmFormChange = function(form, targets, modal) {
                if (!form || !modal) return;
                var returnLink = form.querySelector('input[type="hidden"][name*="return_link"]');
                var saveBtn = modal.querySelector('a[data-action="save"]');
                var cancelBtn = modal.querySelector('a[data-action="cancel"]');
                modal.addEventListener('hidden.bs.modal', function() {
                    if (returnLink) returnLink.value = '';
                });
                if (saveBtn) {
                    saveBtn.addEventListener('click', function() {
                        if (returnLink) returnLink.value = this.dataset.returnLink || '';
                        this.classList.add('disabled');
                        form.submit();
                    });
                }
                targets.forEach(function(target) {
                    target.addEventListener('click', function(e) {
                        e.preventDefault();
                        var nameEl = modal.querySelector('.modal-body .screen-name');
                        if (nameEl) nameEl.textContent = this.getAttribute('title') || '';
                        bootstrap.Modal.getOrCreateInstance(modal).show();
                        if (saveBtn) saveBtn.dataset.returnLink = this.getAttribute('href') || '';
                        if (cancelBtn) cancelBtn.setAttribute('href', this.getAttribute('href') || '');
                        return false;
                    });
                });
            };
            confirmFormChange(
                document.getElementById('form1'),
                document.querySelectorAll('a[data-action="confirm"]'),
                document.getElementById('confirmFormChangeModal')
            );

            // searchWordの実行
            var searchCategory = document.getElementById('search-category');
            if (searchCategory) {
                searchCategory.addEventListener('input', function() {
                    searchWord(this.value, document.querySelectorAll('.category-li'));
                });
            }
        });
    </script>
{% endblock javascript %}

{% block main %}
    <!-- 移動確認モーダル-->
    <div class="modal fade" id="confirmFormChangeModal" tabindex="-1" role="dialog"
         aria-labelledby="confirmFormChangeModal" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'admin.common.move_to_confirm_title'|trans }}</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close">

                    </button>
                </div>
                <div class="modal-body">
                    <p class="screen-name"></p>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-ec-conversion" data-action="save" href="javascript:void(0)">
                        {{ 'admin.common.move_to_confirm_save_and_move'|trans }}
                    </a>
                    <a class="btn btn-ec-sub" data-action="cancel" href="javascript:void(0)">
                        {{ 'admin.common.move_to_confirm_move_only'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    <form role="form" name="form1" id="form1" method="post" action="" novalidate enctype="multipart/form-data">
        {{ form_widget(form._token) }}
        {{ form_widget(form.return_link) }}
        <div class="c-contentsArea__cols">
            <div class="c-contentsArea__primaryCol">
                <div class="c-primaryCol">
                    <div class="card rounded border-0 mb-4">
                        <div class="card-header">
                            <div class="row">
                                <div class="col-8">
                                    <div class="d-inline-block">
                                    <span class="card-title">
                                        {{ 'admin.product.product__card_title'|trans }}
                                    </span>
                                    </div>
                                </div>
                                <div class="col-4 text-end">
                                    <a data-bs-toggle="collapse" href="#basicConfig" aria-expanded="false"
                                       aria-controls="basicConfig">
                                        <i class="fa fa-angle-up fa-lg"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="collapse show ec-cardCollapse" id="basicConfig">
                            <div class="card-body">
                                {% if Product.id %}
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'tooltip.product.product_id'|trans }}">
                                                <span>{{ 'admin.product.product_id'|trans }}</span>
                                                <i class="fa fa-question-circle fa-lg ms-1"></i>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <p>{{ Product.id }}</p>
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="row">
                                    <div class="col-3">
                                        <div class="d-inline-block">
                                            <span>{{ 'admin.product.name'|trans }}</span>
                                            <span class="badge bg-primary ms-1">
                                                {{ 'admin.common.required'|trans }}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col mb-2">
                                        {{ form_widget(form.name) }}
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>
                                {% if has_class == false %}
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'tooltip.product.sale_type'|trans }}">
                                                <span>{{ 'admin.product.sale_type'|trans }}</span>
                                                <i class="fa fa-question-circle fa-lg ms-1"></i>
                                                <span class="badge bg-primary ms-1">
                                                    {{ 'admin.common.required'|trans }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col mb-2">
                                            {{ form_widget(form.class.sale_type) }}
                                            {{ form_errors(form.class.sale_type) }}
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="row">
                                    <div class="col-3">
                                        <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="{{ 'tooltip.product.image'|trans }}">
                                            <span>{{ 'admin.product.image'|trans }}</span>
                                            <i class="fa fa-question-circle fa-lg ms-1"></i>
                                            <br>{{ 'admin.product.image_size'|trans }}
                                        </div>
                                    </div>
                                    <div class="col mb-2">
                                        <p id="message"></p>
                                        <div id="upload-zone" class="rounded">

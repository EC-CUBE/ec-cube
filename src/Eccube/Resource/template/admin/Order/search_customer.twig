<script>
    document.querySelectorAll('.set-customer').forEach(function(btn) {
        btn.addEventListener('click', function() {
            window.eccubeFetch('{{ url('admin_order_search_customer_by_id') }}', {
                method: 'POST',
                body: new URLSearchParams({'id': this.dataset.customer})
            }).then(function(response) { return response.json(); })
            .then(function(data) {
                document.getElementById('order_CustomerId').textContent = data['id'];
                document.getElementById('order_Customer').value = data['id'];
                document.getElementById('order_name_name01').value = data['name01'];
                document.getElementById('order_name_name02').value = data['name02'];
                document.getElementById('order_kana_kana01').value = data['kana01'];
                document.getElementById('order_kana_kana02').value = data['kana02'];
                document.getElementById('order_postal_code').value = data['postal_code'];
                document.getElementById('order_address_pref').value = data['pref'];
                document.getElementById('order_address_addr01').value = data['addr01'];
                document.getElementById('order_address_addr02').value = data['addr02'];
                document.getElementById('order_email').value = data['email'];
                document.getElementById('order_phone_number').value = data['phone_number'];
                document.getElementById('order_company_name').value = data['company_name'];
                bootstrap.Modal.getInstance(document.getElementById('searchCustomerModal'))?.hide();
            }).catch(function() {
                alert('search customer(by id) failed.');
            });
        });
    });

    // 会員検索
    document.querySelectorAll('#customer_pagination a').forEach(function(a) {
        a.addEventListener('click', function(event) {
            event.preventDefault();
            if (!this.parentElement.classList.contains('active')) {
                var list = document.getElementById('searchCustomerModalList');
                list.innerHTML = '';
                fetch(this.getAttribute('href'))
                    .then(function(response) { return response.text(); })
                    .then(function(data) {
                        document.getElementById('searchCustomerModalList').innerHTML = data;
                    }).catch(function() {
                        alert('search customer failed.');
                    });
            }
        });
    });
</script>

<table class="table table-striped">
    <thead class="table-active">
    <tr>
        <th class="pt-2 pb-2 ps-3">{{ 'admin.common.id'|trans }}</th>
        <th class="pt-2 pb-2">{{ 'admin.common.name'|trans }}</th>
        <th class="pt-2 pb-2">{{ 'admin.common.phone_number'|trans }}</th>
        <th class="pt-2 pb-2">{{ 'admin.common.mail_address'|trans }}</th>
        <th class="pt-2 pb-2 ps-5">&nbsp;</th>
    </tr>
    </thead>
    <tbody>
    {% for Customer in data %}
        <tr>
            <td class="text-center"><span>{{ Customer.id }}</span></td>
            <td><span>{{ Customer.name }}</span></td>
            <td><span>{{ Customer.phone_number }}</span></td>
            <td><span>{{ Customer.email }}</span></td>
            <td>
                <div class="row justify-content-end pe-2">
                    <button type="button" class="btn btn-ec-actionIcon set-customer" data-customer="{{ Customer.id }}"><i class="fa fa-plus fa-lg text-secondary" aria-hidden="true"></i></button>
                </div>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% if pagination.totalItemCount > 0 %}
    <div id="customer_pagination" class="row justify-content-md-center mb-4">
        {% include '@admin/pager.twig' with {'pages': pagination.paginationData, 'routes': 'admin_order_search_customer_html_page'} %}
    </div>
{% endif %}

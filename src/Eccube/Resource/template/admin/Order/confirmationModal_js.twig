<script>
    document.addEventListener('DOMContentLoaded', function() {
        var updater;

        // モーダルの表示を制御
        document.querySelectorAll('#bulkSendMail, .confirmationModal').forEach(function(el) {
            el.addEventListener('click', function(e) {
                var modal = document.getElementById('sentUpdateModal');
                var bootstrapModal = new bootstrap.Modal(modal);
                bootstrapModal.show();
                var eventTarget = e.currentTarget;
                var type = eventTarget.dataset.type;
                var isBulk = eventTarget.dataset.bulkUpdate === 'true';
                switch (type) {
                    case 'mail':
                        updater = isBulk ? new BulkSendMail(modal, eventTarget) : new SimpleSendMail(modal, eventTarget);
                        document.getElementById('notificationMail').type = 'hidden';
                        document.querySelectorAll('.notificationMail').forEach(function(n) { n.style.display = 'none'; });
                        var ve = document.getElementById('viewEmail');
                        ve.classList.remove('collapsed');
                        ve.classList.add('collapsed');
                        break;
                    default:
                    case 'status':
                        updater = new SimpleStatusUpdate(modal, eventTarget);
                        document.getElementById('notificationMail').type = 'checkbox';
                        document.querySelectorAll('.notificationMail').forEach(function(n) { n.style.display = ''; });
                        var ve2 = document.getElementById('viewEmail');
                        ve2.classList.remove('collapsed');
                        ve2.classList.add('collapsed');
                }
                var previewUrl = updater.getPreviewUrl();
                if (previewUrl) {
                    window.eccubeFetch(previewUrl).then(function(r) { return r.text(); }).then(function(res) {
                        document.getElementById('viewEmail').innerHTML = res;
                    });
                }
                modal.querySelector('.modal-title').textContent = updater.modalTitle;
                modal.querySelector('.modal-body > p.modal-message').textContent = updater.modalMessage;
                var bulkChange = document.getElementById('bulkChange');
                bulkChange.dataset.bulkUpdate = eventTarget.dataset.bulkUpdate || '';
                bulkChange.dataset.type = eventTarget.dataset.type || '';
                bulkChange.dataset.updateStatusUrl = eventTarget.dataset.updateStatusUrl || '';
                bulkChange.dataset.notifyMailUrl = eventTarget.dataset.notifyMailUrl || '';
                bulkChange.dataset.updateStatusId = eventTarget.dataset.updateStatusId || '';
                bulkChange.textContent = updater.modalButton;
            });
        });

        // プログレスバーの表示を制御
        document.querySelectorAll('#bulkChange, .progressModal').forEach(function(el) {
            el.addEventListener('click', function(e) {
                var eventTarget = e.currentTarget;
                var type = eventTarget.dataset.type;
                var isBulk = eventTarget.dataset.bulkUpdate === 'true';
                if (type == 'status' && isBulk && document.getElementById('option_bulk_status').value === '') {
                    alert('対応状況を選択してください');
                    return;
                }
                var modal = document.getElementById('sentUpdateModal');
                var bootstrapModal = new bootstrap.Modal(modal);
                bootstrapModal.show();
                switch (type) {
                    case 'mail':
                        updater = isBulk ? new BulkSendMail(modal, eventTarget) : new SimpleSendMail(modal, eventTarget);
                        break;
                    default:
                    case 'status':
                        updater = isBulk ? new BulkStatusUpdate(modal, eventTarget) : new SimpleStatusUpdate(modal, eventTarget);
                }
                modal.querySelector('.modal-title').textContent = updater.modalTitle;
                modal.querySelector('.modal-body > p.modal-message').textContent = "{{ 'admin.order.bulk_action__in_progress_message'|trans }}";
                modal.querySelectorAll('button').forEach(function(b) { b.style.display = 'none'; });
                document.getElementById('bulk-options').style.display = 'none';
                modal.querySelector('.progress').style.display = '';
                updater.totalCount = updater.getTotalCount();
                var progress = new ProgressDeferred();
                progress.onProgress(function (result) {
                    updater.progress(result, progress);
                }).onFail(function (result) {
                    updater.fail(result);
                }).onAlways(function (result) {
                    updater.always(result);
                });
                updater.getPromises(progress);
            });
        });
    });

    /*
     * jQuery $.Deferred の progress/fail/always を最低限模倣する軽量実装
     */
    function ProgressDeferred() {
        this._progressFns = [];
        this._failFns = [];
        this._alwaysFns = [];
        this._state = 'pending';
        this._lastData = null;
    }
    ProgressDeferred.prototype = {
        onProgress: function (fn) { this._progressFns.push(fn); return this; },
        onFail: function (fn) { this._failFns.push(fn); return this; },
        onAlways: function (fn) { this._alwaysFns.push(fn); return this; },
        notifyWith: function (data) {
            this._lastData = data;
            this._progressFns.forEach(function (fn) { fn(data); });
        },
        resolve: function () {
            if (this._state !== 'pending') return;
            this._state = 'resolved';
            var data = this._lastData;
            this._alwaysFns.forEach(function (fn) { fn(data); });
        },
        reject: function () {
            if (this._state !== 'pending') return;
            this._state = 'rejected';
            var data = this._lastData;
            this._failFns.forEach(function (fn) { fn(data); });
            this._alwaysFns.forEach(function (fn) { fn(data); });
        }
    };

    /*
     * Super class
     */
    function ConfirmationModal(modal) {
        this.modal = modal;
        this.mailCount = 0;
        this.currentCount = 0;
        this.totalCount = 0;
    }
    ConfirmationModal.prototype = {
        modalTitle: "{{ 'admin.order.to_shipped__confirm_title'|trans }}",
        modalMessage: "{{ 'admin.order.to_shipped__confirm_message'|trans }}",
        modalButton: "{{ 'admin.common.execute'|trans }}",
        getPreviewUrl: function () {
            return null;
        },
        getTotalCount: function () {
            return 1;
        },
        progress: function (result, progress) {
            this.modal.querySelector('.progress-bar').style.width = (++this.currentCount / this.totalCount * 100) + '%';
            if (result && result['message']) {
                var li = document.createElement('li');
                li.innerHTML = '<span class="badge bg-warning">NOTICE</span> ';
                var span = document.createElement('span');
                span.textContent = result['message'];
                li.appendChild(span);
                document.getElementById('bulkErrors').appendChild(li);
            }
            if (this.currentCount >= this.totalCount) {
                progress.resolve();
            }
        },
        fail: function (result) {
            var li = document.createElement('li');
            li.innerHTML = '<span class="badge bg-danger">ERROR</span> ';
            var span = document.createElement('span');
            span.textContent = "{{ 'admin.common.system_error'|trans }}";
            li.appendChild(span);
            document.getElementById('bulkErrors').appendChild(li);
        },
        always: function (result) {
            this.modal.querySelector('.progress').style.display = 'none';
            this.modal.querySelector('.modal-body > p.modal-message').textContent = "{{ 'admin.order.bulk_action__complete_message'|trans }}";
            document.getElementById('bulkChangeComplete').style.display = '';
        },
        getPromises: function (progress, url, data) {
            if (data == undefined) {
                var checked = document.querySelector('input#notificationMail:checked');
                data = {'notificationMail': checked ? checked.value : ''};
            }
            var body = new URLSearchParams();
            for (var key in data) {
                if (data.hasOwnProperty(key) && data[key] !== undefined && data[key] !== null) {
                    body.append(key, data[key]);
                }
            }
            var self = this;
            return window.eccubeFetch(url, { method: 'PUT', body: body })
                .then(function (response) {
                    return response.text().then(function (text) {
                        var json = null;
                        try { json = text ? JSON.parse(text) : null; } catch (e) {}
                        if (!response.ok) {
                            throw { response: response, body: json };
                        }
                        return json;
                    });
                })
                .then(function (data) {
                    progress.notifyWith(data);
                    return data;
                }).catch(function (err) {
                    // 失敗しても進捗カウンタは進める. でないと resolve に到達せずモーダルがハングする.
                    progress.notifyWith(null);
                    ConfirmationModal.prototype.fail.call(self, err);
                });
        }
    };
    /*
     * ステータス一括更新
     */
    function BulkStatusUpdate(modal, eventTarget) {
        ConfirmationModal.call(this, modal);
        this.eventTarget = eventTarget;
    }
    BulkStatusUpdate.prototype = Object.create(ConfirmationModal.prototype, {
        constructor: {
            value: ConfirmationModal
        },
        modalTitle: {
            value: "{{ 'admin.order.change_status'|trans }}"
        },
        getTotalCount: {
            value: function () {
                return document.querySelectorAll('input[data-id]:checked').length;
            }
        },
        getPromises: {
            value: function (progress) {
                var statuses = [];
                document.querySelectorAll('input[data-id]:checked').forEach(function (input) {
                    statuses.push({
                        'url': input.dataset.updateStatusUrl,
                        'data': {'order_status': document.getElementById('option_bulk_status').value}
                    });
                });
                var self = this;
                // ポイントや在庫の加算・減算は非同期で実行できないため、同期処理で実行
                var callback = function () {
                    var status = statuses.shift();
                    if (!status) return;
                    ConfirmationModal.prototype.getPromises.call(self, progress, status.url, status.data)
                        .then(function () {
                            if (statuses.length) {
                                callback();
                            }
                        });
                };
                callback();
            }
        }
    });
    /*
     * ステータス個別更新
     */
    function SimpleStatusUpdate(modal, eventTarget) {
        ConfirmationModal.call(this, modal);
        this.eventTarget = eventTarget;
        this.notifierCompleteMessage = '';
    }
    SimpleStatusUpdate.prototype = Object.create(ConfirmationModal.prototype, {
        constructor: {
            value: ConfirmationModal
        },
        getPreviewUrl: {
            value: function () {
                return this.eventTarget.dataset.previewNotifyMailUrl;
            }
        },
        progress: {
            value: function (result, progress) {
                if (result && result.mail) {
                    this.mailCount++;
                    this.notifierCompleteMessage = '{{ 'admin.order.shipping_mail_send__complete_message'|trans }}'.replace(/%count%/, this.mailCount);
                }
                ConfirmationModal.prototype.progress.call(this, result, progress);
            }
        },
        always: {
            value: function (result) {
                ConfirmationModal.prototype.always.call(this, result);
                this.modal.querySelector('.modal-body > p.modal-message').textContent = "{{ 'admin.order.bulk_action__complete_message'|trans }}" + this.notifierCompleteMessage;
            }
        },
        getPromises: {
            value: function (progress) {
                var url = this.eventTarget.dataset.updateStatusUrl;
                var checked = document.querySelector('input#notificationMail:checked');
                var data = {
                    'order_status': this.eventTarget.dataset.updateStatusId,
                    'notificationMail': checked ? checked.value : ''
                };
                return ConfirmationModal.prototype.getPromises.call(this, progress, url, data);
            }
        }
    });
    /*
     * メール一括送信
     */
    function BulkSendMail(modal) {
        SimpleStatusUpdate.call(this, modal);
    }
    BulkSendMail.prototype = Object.create(SimpleStatusUpdate.prototype, {
        constructor: {
            value: SimpleStatusUpdate
        },
        modalTitle: {
            value: "{{ 'admin.order.shipping_mail_send__confirm_title'|trans }}"
        },
        modalMessage: {
            value: "{{ 'admin.order.shipping_mail_send__confirm_message'|trans }}"
        },
        modalButton: {
            value: "{{ 'admin.common.send'|trans }}"
        },
        getPreviewUrl: {
            value: function () {
                var checked = document.querySelector('input[data-preview-notify-mail-url]:checked');
                return checked ? checked.dataset.previewNotifyMailUrl : null;
            }
        },
        getTotalCount: {
            value: function () {
                return document.querySelectorAll('input[data-preview-notify-mail-url]:checked').length;
            }
        },
        getPromises: {
            value: function (progress) {
                var self = this;
                document.querySelectorAll('input[data-notify-mail-url]:checked').forEach(function (input) {
                    var url = input.dataset.notifyMailUrl;
                    ConfirmationModal.prototype.getPromises.call(self, progress, url);
                });
            }
        }
    });
    /*
     * 個別メール送信
     */
    function SimpleSendMail(modal, relatedTarget) {
        SimpleStatusUpdate.call(this, modal, relatedTarget);
    }
    SimpleSendMail.prototype = Object.create(SimpleStatusUpdate.prototype, {
        constructor: {
            value: SimpleStatusUpdate
        },
        modalTitle: {
            value: "{{ 'admin.order.shipping_mail_send__confirm_title'|trans }}"
        },
        modalMessage: {
            value: "{{ 'admin.order.shipping_mail_send__confirm_message'|trans }}"
        },
        modalButton: {
            value: "{{ 'admin.common.send'|trans }}"
        },
        getPromises: {
            value: function (progress) {
                var url = this.eventTarget.dataset.notifyMailUrl;
                return ConfirmationModal.prototype.getPromises.call(this, progress, url);
            }
        }
    });
</script>

{% extends 'frame.twig' %}

{% set current = 6 %}

{% block script %}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var is_sqlite = {% if is_sqlite %}true{% else %}false{% endif %};
        var csrfToken = '{{ token }}';

        // #plugins の中身（<tr> テンプレート行）をテンプレートとして取得・退避
        var pluginsTable = document.getElementById('plugins');
        var templateRow = pluginsTable ? pluginsTable.firstElementChild : null;
        if (templateRow) {
            templateRow.remove();
        }

        var modal = document.getElementById('PluginProgressModal');
        var bootstrapModal = new bootstrap.Modal(modal);
        bootstrapModal.show();
        var progress = modal.querySelector('div.progress');
        if (progress) progress.style.display = '';
        var progressMessage = document.getElementById('progress_message');
        var modalFooter = modal.querySelector('.modal-footer');
        if (modalFooter) modalFooter.style.display = 'none';
        if (progressMessage) progressMessage.textContent = 'システム要件をチェックしています。しばらくお待ちください...';

        function apiFetch(url, options) {
            options = options || {};
            options.headers = Object.assign({
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'ECCUBE-CSRF-TOKEN': csrfToken
            }, options.headers || {});
            return fetch(url, options);
        }

        // 1. プラグイン一覧取得前に API チェック
        apiFetch('{{ url("install_plugin_check_api") }}', { method: 'PUT' })
            .catch(function(err) { console.warn('install_plugin_check_api failed:', err); })
            .finally(function() {
                if (progressMessage) {
                    progressMessage.textContent = 'プラグインを読み込んでいます。しばらくお待ちください...';
                }

                // 2. プラグイン一覧取得
                apiFetch('{{ url('install_plugins') }}', { method: 'GET' })
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('http error');
                        }
                        return response.json();
                    })
                    .then(function(data) {
                        // 既存の children をクリア
                        while (pluginsTable.firstChild) {
                            pluginsTable.removeChild(pluginsTable.firstChild);
                        }
                        if (!data || data.length === 0) {
                            var pluginsSwitch = document.getElementById('plugins_switch');
                            if (pluginsSwitch) pluginsSwitch.style.display = 'none';
                            return;
                        }

                        data.forEach(function(plugin) {
                            var pluginCode = encodeURIComponent(plugin.code);
                            var content = templateRow.cloneNode(true);
                            var enableUrlTemplate = '{{ url('install_plugin_enable', { 'code': '__code__' }) }}';

                            var toggleSwitch = content.querySelector('.c-toggleSwitch');
                            if (toggleSwitch) {
                                toggleSwitch.dataset.url = enableUrlTemplate.replace(/__code__/, pluginCode);
                            }
                            var nameEl = content.querySelector('.plugin_name');
                            if (nameEl) nameEl.textContent = plugin.name;
                            var checkbox = content.querySelector('input[type=checkbox]');
                            if (checkbox) checkbox.setAttribute('id', pluginCode);
                            var label = content.querySelector('label');
                            if (label) label.setAttribute('for', pluginCode);

                            var statusLabel = content.querySelector('.c-toggleSwitch__label > span');
                            if (plugin.enabled) {
                                if (checkbox) checkbox.checked = true;
                                if (statusLabel) statusLabel.textContent = '有効';
                            } else {
                                if (checkbox) checkbox.checked = false;
                                if (statusLabel) statusLabel.textContent = '無効';
                            }
                            if (is_sqlite && ['Api42'].includes(plugin.code) && toggleSwitch) {
                                toggleSwitch.textContent = 'SQLite3 には対応していません';
                            }
                            pluginsTable.appendChild(content);
                        });
                    })
                    .then(function() {
                        // 3. 各トグルスイッチに change ハンドラを付与
                        var pluginsSwitch = document.getElementById('plugins_switch');
                        if (!pluginsSwitch) return;
                        pluginsSwitch.querySelectorAll('.c-toggleSwitch').forEach(function(toggleSwitch) {
                            var checkbox = toggleSwitch.querySelector('input[type=checkbox]');
                            if (!checkbox) return;
                            checkbox.addEventListener('change', function() {
                                var status = checkbox.checked;
                                var statusSpan = toggleSwitch.querySelector('.c-toggleSwitch__label > span');
                                if (statusSpan) statusSpan.textContent = status ? '有効' : '無効';
                                var statusText = statusSpan ? statusSpan.textContent : '';

                                bootstrapModal.show();
                                if (progress) progress.style.display = '';
                                if (modalFooter) modalFooter.style.display = 'none';
                                if (progressMessage) progressMessage.textContent = 'プラグインを' + statusText + '化しています...';

                                apiFetch(toggleSwitch.dataset.url, { method: 'PUT' })
                                    .then(function(response) {
                                        if (!response.ok) {
                                            // 非 2xx は fail 扱い. response をエラーとして throw
                                            var err = new Error('http error');
                                            err.status = response.status;
                                            throw err;
                                        }
                                        if (progress) progress.style.display = 'none';
                                        bootstrapModal.hide();
                                    })
                                    .catch(function(err) {
                                        // 失敗時はモーダルを開いたままエラー文言を表示し,
                                        // ユーザがフッターの閉じるボタンで手動で閉じる導線にする.
                                        if (progress) progress.style.display = 'none';
                                        if (modalFooter) modalFooter.style.display = '';
                                        checkbox.checked = !status;
                                        if (statusSpan) statusSpan.textContent = !status ? '有効' : '無効';
                                        console.log(err);
                                        if (progressMessage) {
                                            if (err && err.status == 404) {
                                                progressMessage.textContent = '一定時間経過したため' + statusText + '化ができません。管理画面にログインし、オーナーズストア→プラグイン→プラグイン一覧から再度お試しください。';
                                            } else {
                                                progressMessage.textContent = statusText + '化に失敗しました。';
                                            }
                                        }
                                    });
                            });
                        });
                    })
                    .catch(function(err) {
                        console.log(err);
                    })
                    .finally(function() {
                        // モーダルをクローズ
                        if (progress) progress.style.display = 'none';
                        bootstrapModal.hide();

                        // 管理画面へのボタンを有効化
                        var goToAdmin = document.getElementById('go_to_admin_page');
                        if (goToAdmin) {
                            goToAdmin.classList.remove('disabled');
                            goToAdmin.removeAttribute('tabindex');
                            goToAdmin.setAttribute('href', "{{ url('install_plugin_redirect') }}");
                        }
                    });
            });
    });
    </script>
{% endblock %}

{% block main %}
<div id="main" class="step7">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="page-header">
                    <h1>{{ 'install.completed'|trans }}</h1>
                </div>
                <div class="column" id="plugins_switch">
                    <h2>以下のプラグインは有効化してすぐにご利用可能です</h2>
                    <p><small>あとから管理画面→オーナーズストア→プラグイン一覧より有効化も可能です</small></p>
                    <div class="card-body p-0">
                        <table class="table table-sm">
                            <tbody id="plugins">
                                <tr>
                                    <td class="text-left pl-3 plugin_name">__name__</td>
                                    <td class="align-middle plugin_status">
                                        <div class="c-toggleSwitch" data-url="__url__">
                                            <div class="c-toggleSwitch__btn">
                                                <input type="checkbox" id="flexSwitchCheckDefault">
                                                <label for="flexSwitchCheckDefault"></label>
                                            </div>
                                            <div class="c-toggleSwitch__label">
                                                <span class="text-dark">有効</span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="column">
                    <h2>{{ 'install.access_admin_page'|trans}}</h2>
                    <p>{{ 'install.perform_initial_setting'|trans }}</p>
                    <div class="btn_area">
                        <a id="go_to_admin_page" tabindex="-1" class="btn btn-primary btn-block btn-lg disabled">{{ 'install.go_to_admin_page'|trans }}</a>
                    </div>
                </div>
            </div>
            <!-- /.col -->
        </div>
    </div>
</div>
<div class="modal fade" id="PluginProgressModal" tabindex="-1" role="dialog"
     aria-labelledby="PluginProgressModal" aria-hidden="true"
     data-bs-keyboard="false" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="progress_message"></h5>
            </div>
            <div class="modal-body text-left">
                <div class="progress" style="display: none">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" type="button" data-bs-dismiss="modal">{{ 'admin.common.close'|trans }}</button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

    ,"image": "{{ asset('assets/img/common/site_image.png', 'user_data') }}",
    "sameAs": [
        "https://twitter.com/EC_CUBE",
        "https://www.ec-cube.net/"
    ],
    "numberOfEmployees": {
        "@type": "QuantitativeValue",
        "value": 2056
    },
    "foundingDate": "1970-01-01"
#}
}
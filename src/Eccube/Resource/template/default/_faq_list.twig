FAQ（よくある質問）の一覧表示。
サイト共通FAQブロック・商品詳細（商品ごとFAQ）・商品一覧（カテゴリごとFAQ）で共用する。
呼び出し側から `Faqs`（Faq エンティティの配列）を渡す。

    {% include '_faq_list.twig' with {'Faqs': Faqs|default([])} only %}
#}
{% if Faqs is not empty %}
    <div class="ec-role ec-faqRole">
        <div class="ec-secHeading">
            <span class="ec-secHeading__en">{{ 'front.block.faq.title__en'|trans }}</span>
            <span class="ec-secHeading__line"></span>
            <span class="ec-secHeading__ja">{{ 'front.block.faq.title__ja'|trans }}</span>
        </div>
        <div class="ec-faqRole__list">
            {% for Faq in Faqs %}
                <dl class="ec-faqRole__item">
                    <dt class="ec-faqRole__question">{{ Faq.question }}</dt>
                    <dd class="ec-faqRole__answer">{{ Faq.answer|purify|nl2br }}</dd>
                </dl>
            {% endfor %}
        </div>
    </div>
{% endif %}

#!/usr/bin/env php
<?php

if (!file_exists(dirname(__DIR__).'/vendor/autoload.php')) {
    echo "Unable to find the `vendor/autoload.php` file. Did you run `composer install`?\n";
    exit(1);
}

$_SERVER['argv'][0] = realpath(dirname(__DIR__).'/vendor/bin/phpunit');

require dirname(__DIR__).'/vendor/bin/phpunit';

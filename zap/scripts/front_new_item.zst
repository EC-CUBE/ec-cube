        "body": "<!doctype html>\n<html lang=\"ja\">\n<head prefix=\"og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# product: https://ogp.me/ns/product#\">\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta name=\"eccube-csrf-token\" content=\"d55500c0937a13.rSlnDxet7sUeaGyNLLYhGU-5O_Gy_aLGNtBqBi7OrX4.nhELVWbFiOhzJzj3YNlrdSneS4PKsdjwX4QOfBqdyy35QRZIT-6tllUxVA\">\n    <title>EC-CUBE SHOP / TOPページ</title>\n                    \n<meta property=\"og:type\" content=\"website\"/>\n<meta property=\"og:site_name\" content=\"EC-CUBE SHOP\"/>\n                <meta property=\"og:url\" content=\"https://ec-cube/\"/>\n    <link rel=\"canonical\" href=\"https://ec-cube/\" />\n    \n                    <link rel=\"icon\" href=\"/html/user_data/assets/img/common/favicon.ico\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.3.1/css/all.css\" integrity=\"sha384-mzrmE5qonljUremFsqc01SB46JvROS7bZs3IO2EmfFsd15uHvIt+Y8vEf7N7fWAU\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"/html/template/default/assets/css/style.css\">\n    <script src=\"/html/bundle/front.bundle.js\"></script>\n        <style>\n        .slick-slider {\n            margin-bottom: 30px;\n        }\n\n        .slick-dots {\n            position: absolute;\n            bottom: -45px;\n            display: block;\n            width: 100%;\n            padding: 0;\n            list-style: none;\n            text-align: center;\n        }\n\n        .slick-dots li {\n            position: relative;\n            display: inline-block;\n            width: 20px;\n            height: 20px;\n            margin: 0 5px;\n            padding: 0;\n\n            cursor: pointer;\n        }\n\n        .slick-dots li button {\n            font-size: 0;\n            line-height: 0;\n            display: block;\n            width: 20px;\n            height: 20px;\n            padding: 5px;\n            cursor: pointer;\n            color: transparent;\n            border: 0;\n            outline: none;\n            background: transparent;\n        }\n\n        .slick-dots li button:hover,\n        .slick-dots li button:focus {\n            outline: none;\n        }\n\n        .slick-dots li button:hover:before,\n        .slick-dots li button:focus:before {\n            opacity: 1;\n        }\n\n        .slick-dots li button:before {\n            content: \" \";\n            line-height: 20px;\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 12px;\n            height: 12px;\n            text-align: center;\n            opacity: .25;\n            background-color: black;\n            border-radius: 50%;\n\n        }\n\n        .slick-dots li.slick-active button:before {\n            opacity: .75;\n            background-color: black;\n        }\n\n        .slick-dots li button.thumbnail img {\n            width: 0;\n            height: 0;\n        }\n    </style>\n    <script>\n        $(function() {\n            $.ajaxSetup({\n                'headers': {\n                    'ECCUBE-CSRF-TOKEN': $('meta[name=\"eccube-csrf-token\"]').attr('content')\n                }\n            });\n        });\n    </script>\n                    <!-- ▼Googleアナリティクス -->\n            \n        <!-- ▲Googleアナリティクス -->\n\n                <link rel=\"stylesheet\" href=\"/html/user_data/assets/css/customize.css\">\n</head>\n<body id=\"page_homepage\" class=\"front_page\">\n\n\n                <div class=\"ec-debugModeAlert bg-danger\">\n            <div>\n                <div class=\"ec-debugModeAlert__icon\"><img src=\"/html/template/default/assets/icon/exclamation-white.svg\"/></div>\n                デバッグモードが有効になっています。\n            </div>\n        </div>\n    \n<div class=\"ec-layoutRole\">\n                <header class=\"ec-layoutRole__header\">\n                <!-- ▼ヘッダー(商品検索・ログインナビ・カート) -->\n            <div class=\"ec-headerNaviRole\">\n    <div class=\"ec-headerNaviRole__left\">\n        <div class=\"ec-headerNaviRole__search\">\n            \n<div class=\"ec-headerSearch\">\n    <form method=\"get\" class=\"searchform\" action=\"/products/list\">\n        <div class=\"ec-headerSearch__category\">\n            <div class=\"ec-select ec-select_search\">\n                            <select name=\"category_id\" class=\"category_id\"><option value=\"\">全ての商品</option><option value=\"2\">新入荷</option><option value=\"1\">ジェラート</option><option value=\"3\">　彩のデザート</option><option value=\"4\">　　CUBE</option><option value=\"5\">アイスサンド</option><option value=\"6\">　フルーツ</option></select>\n    \n            </div>\n        </div>\n        <div class=\"ec-headerSearch__keyword\">\n            <div class=\"ec-input\">\n                <input type=\"search\" name=\"name\" maxlength=\"50\" class=\"search-name\" placeholder=\"キーワードを入力\" />\n                <button class=\"ec-headerSearch__keywordBtn\" type=\"submit\">\n                    <div class=\"ec-icon\">\n                        <img src=\"/html/template/default/assets/icon/search-dark.svg\" alt=\"\">\n                    </div>\n                </button>\n            </div>\n        </div>\n    </form>\n</div>\n\n        </div>\n        <div class=\"ec-headerRole__navSP\">\n            \n<div class=\"ec-headerNavSP\">\n    <i class=\"fas fa-bars\"></i>\n</div>\n        </div>\n    </div>\n    <div class=\"ec-headerNaviRole__right\">\n        <div class=\"ec-headerNaviRole__nav\">\n            \n<div class=\"ec-headerNav\">\n            <div class=\"ec-headerNav__item\">\n            <a href=\"https://ec-cube/entry\">\n                <i class=\"ec-headerNav__itemIcon fas fa-user fa-fw\"></i>\n                <span class=\"ec-headerNav__itemLink\">新規会員登録</span>\n            </a>\n        </div>\n                    <div class=\"ec-headerNav__item\">\n                <a href=\"https://ec-cube/mypage/favorite\">\n                    <i class=\"ec-headerNav__itemIcon fas fa-heart fa-fw\"></i>\n                    <span class=\"ec-headerNav__itemLink\">お気に入り</span>\n                </a>\n            </div>\n                <div class=\"ec-headerNav__item\">\n            <a href=\"https://ec-cube/mypage/login\">\n                <i class=\"ec-headerNav__itemIcon fas fa-lock fa-fw\"></i>\n                <span class=\"ec-headerNav__itemLink\">ログイン</span>\n            </a>\n        </div>\n    </div>\n\n        </div>\n        <div class=\"ec-headerRole__cart\">\n            <div class=\"ec-cartNaviWrap\">\n    <div class=\"ec-cartNavi\">\n        <i class=\"ec-cartNavi__icon fas fa-shopping-cart\">\n            <span class=\"ec-cartNavi__badge\">0</span>\n        </i>\n        <div class=\"ec-cartNavi__label\">\n            <div class=\"ec-cartNavi__price\">￥0</div>\n        </div>\n    </div>\n            <div class=\"ec-cartNaviNull\">\n            <div class=\"ec-cartNaviNull__message\">\n                <p>現在カート内に商品はございません。</p>\n            </div>\n        </div>\n    </div>\n\n        </div>\n    </div>\n</div>\n\n        <!-- ▲ヘッダー(商品検索・ログインナビ・カート) -->\n    <!-- ▼ロゴ -->\n            <div class=\"ec-headerRole\">\n    <div class=\"ec-headerRole__title\">\n        <div class=\"ec-headerTitle\">\n            <div class=\"ec-headerTitle__title\">\n                <h1>\n                    <a href=\"https://ec-cube/\">\n                        EC-CUBE SHOP\n                    </a>\n                </h1>\n            </div>\n        </div>\n    </div>\n</div>\n\n        <!-- ▲ロゴ -->\n    <!-- ▼カテゴリナビ(PC) -->\n            \n\n\n<div class=\"ec-categoryNaviRole\">\n    <div class=\"ec-itemNav\">\n        <ul class=\"ec-itemNav__nav\">\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=2\">\n        新入荷\n    </a>\n    \n                </li>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=1\">\n        ジェラート\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=3\">\n        彩のデザート\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=4\">\n        CUBE\n    </a>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=5\">\n        アイスサンド\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=6\">\n        フルーツ\n    </a>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                    </ul>\n    </div>\n</div>\n\n        <!-- ▲カテゴリナビ(PC) -->\n\n        </header>\n    \n        \n    <div class=\"ec-layoutRole__contents\">\n                \n                \n        <main class=\"ec-layoutRole__main\">\n                        \n                            <div class=\"ec-sliderRole\">\n        <div class=\"main_visual\">\n            <div class=\"item slick-slide\"><img src=\"/html/template/default/assets/img/top/img_hero_pc01.jpg\"></div>\n            <div class=\"item slick-slide\"><img src=\"/html/template/default/assets/img/top/img_hero_pc02.jpg\"></div>\n            <div class=\"item slick-slide\"><img src=\"/html/template/default/assets/img/top/img_hero_pc03.jpg\"></div>\n        </div>\n    </div>\n\n                                        <div class=\"ec-layoutRole__mainBottom\">\n                        <!-- ▼新入荷商品特集 -->\n            \n<div class=\"ec-role\">\n    <div class=\"ec-eyecatchRole\">\n        <div class=\"ec-eyecatchRole__image\">\n            <img src=\"/html/template/default/assets/img/top/img_about.jpg\" alt=\"\" role=\"presentation\"/>\n        </div>\n        <div class=\"ec-eyecatchRole__intro\">\n            <p class=\"ec-eyecatchRole__introEnTitle\">CUBE GELATO ICE</p>\n            <p class=\"ec-eyecatchRole__introTitle\">彩のジェラート&quot;CUBE&quot;をご堪能ください。</p>\n            <p class=\"ec-eyecatchRole__introDescription\">ジェラートとはイタリアン・アイスクリームのことで、一般的なアイスクリームに比べて、乳脂肪分が低くいのが特徴です。<br />\n当店では厳選した旬の果物のおいしさをそのままジェラートに仕上げました。風味が濃厚でありながら、甘さ控えめでヘルシーなキューブジェラートをご堪能ください。<br />\nさらにジェラートの製法を活かした、アイスキャンディ・アイスサンドも販売しております。<br />\n</p>\n            <a class=\"ec-blockBtn--top\" href=\"https://ec-cube/products/list?category_id=4\">一覧を見る</a>\n        </div>\n    </div>\n</div>\n\n        <!-- ▲新入荷商品特集 -->\n    <!-- ▼トピック -->\n            \n<div class=\"ec-topicRole\">\n    <div class=\"ec-role\">\n        <div class=\"ec-secHeading\">\n            <span class=\"ec-secHeading__en\">TOPICS</span>\n            <span class=\"ec-secHeading__line\"></span>\n            <span class=\"ec-secHeading__ja\">特集</span>\n        </div>\n        <div class=\"ec-topicRole__list\">\n            <div class=\"ec-topicRole__listItem\">\n                <a href=\"https://ec-cube/products/list?category_id=1\">\n                    <img src=\"/html/template/default/assets/img/top/img_bnr01.jpg\">\n                </a>\n                <p class=\"ec-topicRole__listItemTitle\">濃厚なのにアイスよりヘルシー!! ジェラート特集</p>\n            </div>\n            <div class=\"ec-topicRole__listItem\">\n                <a href=\"https://ec-cube/products/list?category_id=5\">\n                    <img src=\"/html/template/default/assets/img/top/img_bnr02.jpg\">\n                </a>\n                <p class=\"ec-topicRole__listItemTitle\">サクサク食感が魅力!! コーンアイス特集</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n        <!-- ▲トピック -->\n    <!-- ▼新着商品 -->\n            \n<div class=\"ec-role\">\n    <div class=\"ec-newItemRole\">\n        <div class=\"ec-newItemRole__list\">\n            <div class=\"ec-newItemRole__listItem\">\n                <div class=\"ec-newItemRole__listItemHeading ec-secHeading--tandem\">\n                    <span class=\"ec-secHeading__en\">NEW ITEM</span>\n                    <span class=\"ec-secHeading__line\"></span>\n                    <span class=\"ec-secHeading__ja\">新着商品</span>\n                    <a class=\"ec-inlineBtn--top\" href=\"https://ec-cube/products/list\">more</a>\n                </div>\n            </div>\n            <div class=\"ec-newItemRole__listItem\">\n                <a href=\"https://ec-cube/products/detail/1\">\n                    <img src=\"/html/upload/save_image/cube-1.png\">\n                    <p class=\"ec-newItemRole__listItemTitle\">彩のジェラート&quot;CUBE&quot;</p>\n                    <p class=\"ec-newItemRole__listItemPrice\">￥1,200(税込)</p>\n                </a>\n            </div>\n            <div class=\"ec-newItemRole__listItem\">\n                <a href=\"https://ec-cube/products/detail/2\">\n                    <img src=\"/html/upload/save_image/sand-1.png\">\n                    <p class=\"ec-newItemRole__listItemTitle\">チェリーアイスサンド</p>\n                    <p class=\"ec-newItemRole__listItemPrice\">￥800(税込)</p>\n                </a>\n            </div>\n            <div class=\"ec-newItemRole__listItem\">\n                <a href=\"https://ec-cube/products/detail/1\">\n                    <img src=\"/html/upload/save_image/no_image_product.png\">\n                    <p class=\"ec-newItemRole__listItemTitle\">彩のジェラート&quot;CUBE&quot; NEO</p>\n                    <p class=\"ec-newItemRole__listItemPrice\">￥600(税込)</p>\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n        <!-- ▲新着商品 -->\n    <!-- ▼カテゴリ -->\n            \n<div class=\"ec-categoryRole\">\n    <div class=\"ec-role\">\n        <div class=\"ec-secHeading\">\n            <span class=\"ec-secHeading__en\">CATEGORY</span>\n            <span class=\"ec-secHeading__line\"></span>\n            <span class=\"ec-secHeading__ja\">カテゴリ</span>\n        </div>\n        <div class=\"ec-categoryRole__list\">\n            <div class=\"ec-categoryRole__listItem\">\n                <a href=\"https://ec-cube/products/list?category_id=2\">\n                    <img src=\"/html/template/default/assets/img/top/fpo_355x150.png\">\n                </a>\n            </div>\n            <div class=\"ec-categoryRole__listItem\">\n                <a href=\"https://ec-cube/products/list?category_id=1\">\n                    <img src=\"/html/template/default/assets/img/top/fpo_355x150.png\">\n                </a>\n            </div>\n            <div class=\"ec-categoryRole__listItem\">\n                <a href=\"https://ec-cube/products/list?category_id=5\">\n                    <img src=\"/html/template/default/assets/img/top/fpo_355x150.png\">\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n\n        <!-- ▲カテゴリ -->\n    <!-- ▼新着情報 -->\n            \n    <script>\n        $(function() {\n            $('.ec-newsRole__news').each(function() {\n                var listLength = $(this).find('.ec-newsRole__newsItem').length;\n                if (listLength > 5) {\n                    $(this).find('.ec-newsRole__newsItem:gt(4)').each(function() {\n                        $(this).hide();\n                    });\n                    $(this).append('<a id=\"news_readmore\" class=\"ec-inlineBtn--top\">more</a>');\n                    var dispNum = 5;\n                    $(this).find('#news_readmore').click(function() {\n                        dispNum += 5;\n                        $(this).parent().find('.ec-newsRole__newsItem:lt(' + dispNum + ')').show();\n                        if (dispNum >= listLength) {\n                            $(this).hide();\n                        }\n                    })\n                }\n            });\n\n            $('.ec-newsRole__newsHeading').on('click', function() {\n                $newsItem = $(this).parent('.ec-newsRole__newsItem');\n                $newsDescription = $newsItem.children('.ec-newsRole__newsDescription');\n                if ($newsDescription.css('display') == 'none') {\n                    $newsItem.addClass('is_active');\n                    $newsDescription.slideDown(300);\n                } else {\n                    $newsItem.removeClass('is_active');\n                    $newsDescription.slideUp(300);\n                }\n                return false;\n            });\n        });\n    </script>\n<div class=\"ec-role\">\n    <div class=\"ec-newsRole\">\n        <div class=\"ec-secHeading\">\n            <span class=\"ec-secHeading__en\">NEWS</span>\n            <span class=\"ec-secHeading__line\"></span>\n            <span class=\"ec-secHeading__ja\">新着情報</span>\n        </div>\n        <div class=\"ec-newsRole__news\">\n                            <div class=\"ec-newsRole__newsItem\">\n                    <div class=\"ec-newsRole__newsHeading\">\n                        <div class=\"ec-newsRole__newsDate\">\n                            2018/09/01\n                        </div>\n                        <div class=\"ec-newsRole__newsColumn\">\n                            <div class=\"ec-newsRole__newsTitle\">\n                                サイトオープンいたしました!\n                            </div>\n                                                            <div class=\"ec-newsRole__newsClose\">\n                                    <a class=\"ec-newsRole__newsCloseBtn\">\n                                        <i class=\"fas fa-angle-down\"></i>\n                                    </a>\n                                </div>\n                                                    </div>\n                    </div>\n                    <div class=\"ec-newsRole__newsDescription\">\n                        旬の色どりスイーツとこだわりのジェラートをお届けします。\n                                            </div>\n                </div>\n                    </div>\n    </div>\n</div>\n\n        <!-- ▲新着情報 -->\n\n                </div>\n                    </main>\n\n                    </div>\n\n        \n                <footer class=\"ec-layoutRole__footer\">\n                <!-- ▼フッター -->\n            <div class=\"ec-footerRole\">\n    <div class=\"ec-footerRole__inner\">\n        <ul class=\"ec-footerNavi\">\n            <li class=\"ec-footerNavi__link\">\n                <a href=\"https://ec-cube/help/about\">当サイトについて</a>\n            </li>\n            <li class=\"ec-footerNavi__link\">\n                <a href=\"https://ec-cube/help/privacy\">プライバシーポリシー</a>\n            </li>\n            <li class=\"ec-footerNavi__link\">\n                <a href=\"https://ec-cube/help/tradelaw\">特定商取引法に基づく表記</a>\n            </li>\n            <li class=\"ec-footerNavi__link\">\n                <a href=\"https://ec-cube/contact\">お問い合わせ</a>\n            </li>\n        </ul>\n        <div class=\"ec-footerTitle\">\n            <div class=\"ec-footerTitle__logo\">\n                <a href=\"https://ec-cube/\">EC-CUBE SHOP</a>\n            </div>\n            <div class=\"ec-footerTitle__copyright\">copyright (c) EC-CUBE SHOP all rights reserved.</div>\n        </div>\n    </div>\n</div>\n\n        <!-- ▲フッター -->\n\n        </footer>\n    </div><!-- ec-layoutRole -->\n\n<div class=\"ec-overlayRole\"></div>\n<div class=\"ec-drawerRoleClose\"><i class=\"fas fa-times\"></i></div>\n<div class=\"ec-drawerRole\">\n                    <!-- ▼商品検索 -->\n            \n<div class=\"ec-headerSearch\">\n    <form method=\"get\" class=\"searchform\" action=\"/products/list\">\n        <div class=\"ec-headerSearch__category\">\n            <div class=\"ec-select ec-select_search\">\n                            <select name=\"category_id\" class=\"category_id\"><option value=\"\">全ての商品</option><option value=\"2\">新入荷</option><option value=\"1\">ジェラート</option><option value=\"3\">　彩のデザート</option><option value=\"4\">　　CUBE</option><option value=\"5\">アイスサンド</option><option value=\"6\">　フルーツ</option></select>\n    \n            </div>\n        </div>\n        <div class=\"ec-headerSearch__keyword\">\n            <div class=\"ec-input\">\n                <input type=\"search\" name=\"name\" maxlength=\"50\" class=\"search-name\" placeholder=\"キーワードを入力\" />\n                <button class=\"ec-headerSearch__keywordBtn\" type=\"submit\">\n                    <div class=\"ec-icon\">\n                        <img src=\"/html/template/default/assets/icon/search-dark.svg\" alt=\"\">\n                    </div>\n                </button>\n            </div>\n        </div>\n    </form>\n</div>\n\n        <!-- ▲商品検索 -->\n    <!-- ▼カテゴリナビ(SP) -->\n            \n\n\n<div class=\"ec-headerCategoryArea\">\n    <div class=\"ec-headerCategoryArea__heading\">\n        <p>カテゴリ一覧</p>\n    </div>\n    <div class=\"ec-itemNav\">\n        <ul class=\"ec-itemNav__nav\">\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=2\">\n        新入荷\n    </a>\n    \n                </li>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=1\">\n        ジェラート\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=3\">\n        彩のデザート\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=4\">\n        CUBE\n    </a>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=5\">\n        アイスサンド\n    </a>\n            <ul>\n                            <li>\n                            <a href=\"https://ec-cube/products/list?category_id=6\">\n        フルーツ\n    </a>\n    \n                </li>\n                    </ul>\n    \n                </li>\n                    </ul>\n    </div>\n</div>\n\n        <!-- ▲カテゴリナビ(SP) -->\n    <!-- ▼ログインナビ(SP) -->\n            \n<div class=\"ec-headerLinkArea\">\n    <div class=\"ec-headerLink__list\">\n        <a class=\"ec-headerLink__item\" href=\"https://ec-cube/cart\">\n            <div class=\"ec-headerLink__icon\">\n                <i class=\"fas fa-shopping-cart fa-fw\"></i>\n            </div>\n            <span>カートを見る</span>\n        </a>\n                    <a class=\"ec-headerLink__item\" href=\"https://ec-cube/entry\">\n                <div class=\"ec-headerLink__icon\">\n                    <i class=\"fas fa-user fa-fw\"></i>\n                </div>\n                <span>新規会員登録</span>\n            </a>\n                            <a class=\"ec-headerLink__item\" href=\"https://ec-cube/mypage/favorite\">\n                    <div class=\"ec-headerLink__icon\">\n                        <i class=\"fas fa-heart fa-fw\"></i>\n                    </div>\n                    <span>お気に入り</span>\n                </a>\n                        <a class=\"ec-headerLink__item\" href=\"https://ec-cube/mypage/login\">\n                <div class=\"ec-headerLink__icon\">\n                    <i class=\"fas fa-lock fa-fw\"></i>\n                </div>\n                <span>ログイン</span>\n            </a>\n                <a class=\"ec-headerLink__item\" href=\"https://ec-cube/\">\n            <div class=\"ec-headerLink__icon\">\n                <i class=\"fas fa-home fa-fw\"></i>\n            </div>\n            <span>ホームに戻る</span>\n        </a>\n    </div>\n</div>\n\n        <!-- ▲ログインナビ(SP) -->\n\n    </div>\n<div class=\"ec-blockTopBtn pagetop\">ページトップへ</div>\n<script>\nvar eccube_lang = {\n    'common.delete_confirm': \"削除してもよろしいですか?\",\n    'front.product.out_of_stock': \"ただいま品切れ中です。\",\n};\n</script>\n<script src=\"/html/template/default/assets/js/function.js\"></script>\n<script src=\"/html/template/default/assets/js/eccube.js\"></script>\n    <script>\n        
                          </button>\n                            </div>\n                        \n                        <input type=\"hidden\" id=\"product_id\" name=\"product_id\" value=\"3\" /><input type=\"hidden\" id=\"ProductClass\" name=\"ProductClass\" value=\"12\" /><input type=\"hidden\" id=\"_token\" name=\"_token\" value=\"22a5c2f2a5e78ddb3d1085.9dkxZ94n-b7356g58s9LSkQWsiUCSEFeZHyd8DOwGbI.xIwIK5lmgPyZv_Jal_k9BShTn05jHGwpKRr3uUD5W-3ArWARnVPAx6Cg4Q\" />\n                    </form>\n                    <div class=\"ec-modal\">\n                        <div class=\"ec-modal-overlay\">\n                            <div class=\"ec-modal-wrap\">\n                                <span class=\"ec-modal-close\"><span class=\"ec-icon\"><img src=\"/html/template/default/assets/icon/cross-dark.svg\" alt=\"\"/></span></span>\n                                <div id=\"ec-modal-header\" class=\"text-center\">カートに追加しました。</div>\n                                <div class=\"ec-modal-box\">\n                                    <div class=\"ec-role\">\n                                        <span class=\"ec-inlineBtn--cancel\">お買い物を続ける</span>\n                                        <a href=\"https://ec-cube/cart\" class=\"ec-inlineBtn--action\">カートへ進む</a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                                            <form action=\"https://ec-cube/products/add_favorite/3\" method=\"post\">\n                            <div class=\"ec-productRole__btn\">\n                                                                    <button type=\"submit\" id=\"favorite\" class=\"ec-blockBtn--cancel\">\n                                        お気に入りに追加\n                                    </button>\n                                                            </div>\n                        </form>\n                         